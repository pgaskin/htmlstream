-- VoidElementsXML11 universal --
The XML 1.1 line ends apply to the text after a void element.
-- in quoted --
"<?xml version=\"1.1\"?><html xmlns=\"http://www.w3.org/1999/xhtml\"><br>c\u0085d</html>"
