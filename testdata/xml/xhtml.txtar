3 EndTag img [implied] ""
2 EndTag BR [stray] "</BR>"
3 StartTag input "<input>" ns="http://www.w3.org/1999/xhtml"
3 EndTag input [implied] ""
2 EndTag body "</body>"
1 EndTag html "</html>"
1 StartTag br "<br>"
1 EndTag br [implied] [unsound] ""
-- ImageUnderXMLRules universal --
image isn't an XHTML element: only HTML parsers turn it into img, so under
XML rules it is an ordinary element.
-- in --
<?xml version="1.0"?>
<html xmlns="http://www.w3.org/1999/xhtml"><image src="a">x</image></html>
-- tokens --
0 ProcInst xml "<?xml version=\"1.0\"?>" data=" version=\"1.0\""
0 Text "\n" text="\n"
1 StartTag html "<html xmlns=\"http://www.w3.org/1999/xhtml\">" ns="http://www.w3.org/1999/xhtml" xmlns="http://www.w3.org/1999/xhtml"
2 StartTag image "<image src=\"a\">" ns="http://www.w3.org/1999/xhtml" src="a"
2 Text "x" text="x"
2 EndTag image "</image>"
1 EndTag html "</html>"
