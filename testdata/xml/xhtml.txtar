-- WithoutDeclaration universal --
Without an XML declaration, the document is read like in HTML mode with XML
syntax, also with the XHTML namespace declared on its root: script contents
are raw text, p elements don't nest, image is void, and void elements are
closed by their end tag.
-- in --
<html xmlns="http://www.w3.org/1999/xhtml"><script>a<b</script><p>a<p>b<br></br><image src="a">x</image><x:br/><svg><p>c</svg></html>
-- tokens --
1 StartTag html "<html xmlns=\"http://www.w3.org/1999/xhtml\">" ns="http://www.w3.org/1999/xhtml" xmlns="http://www.w3.org/1999/xhtml"
2 StartTag script "<script>" ns="http://www.w3.org/1999/xhtml"
2 Text "a<b" text="a<b"
2 EndTag script "</script>"
2 StartTag p "<p>" ns="http://www.w3.org/1999/xhtml"
2 Text "a" text="a"
2 EndTag p [implied] ""
2 StartTag p "<p>" ns="http://www.w3.org/1999/xhtml"
2 Text "b" text="b"
3 StartTag br "<br>" ns="http://www.w3.org/1999/xhtml"
3 EndTag br "</br>"
3 StartTag image "<image src=\"a\">" ns="http://www.w3.org/1999/xhtml" src="a"
3 EndTag image [implied] ""
2 Text "x" text="x"
2 EndTag image [stray] "</image>"
2 StartTag x:br [self-closing] "<x:br/>" ns="http://www.w3.org/1999/xhtml"
3 StartTag svg "<svg>" ns="http://www.w3.org/2000/svg"
3 EndTag svg [implied] [unsound] ""
2 EndTag p [implied] ""
2 StartTag p "<p>" ns="http://www.w3.org/1999/xhtml"
2 Text "c" text="c"
2 EndTag svg [stray] "</svg>"
2 EndTag p [implied] ""
1 EndTag html "</html>"
-- PrefixedRoot universal --
A root with a prefix bound to XHTML: elements without a prefix are in no
namespace, the p elements nest, script contents are markup, and h:br is a
void element.
-- in --
<?xml version="1.0"?>
<h:html xmlns:h="http://www.w3.org/1999/xhtml"><h:body><p>a<p>b</p></p><script><b>x</b></script><h:br>c</h:body></h:html>
-- tokens --
0 ProcInst xml "<?xml version=\"1.0\"?>" data=" version=\"1.0\""
0 Text "\n" text="\n"
1 StartTag h:html "<h:html xmlns:h=\"http://www.w3.org/1999/xhtml\">" ns="http://www.w3.org/1999/xhtml" xmlns:h="http://www.w3.org/1999/xhtml"
2 StartTag h:body "<h:body>" ns="http://www.w3.org/1999/xhtml"
3 StartTag p "<p>"
3 Text "a" text="a"
4 StartTag p "<p>"
4 Text "b" text="b"
4 EndTag p "</p>"
3 EndTag p "</p>"
3 StartTag script "<script>"
4 StartTag b "<b>"
4 Text "x" text="x"
4 EndTag b "</b>"
3 EndTag script "</script>"
3 StartTag h:br "<h:br>" ns="http://www.w3.org/1999/xhtml"
3 EndTag h:br [implied] ""
2 Text "c" text="c"
2 EndTag h:body "</h:body>"
1 EndTag h:html "</h:html>"
-- OtherRoot universal --
After an XML declaration, a first start tag which doesn't declare the XHTML
namespace for its own name makes the document read as HTML, even where an
element in it declares it. Universal mode isn't for other XML: the link
element of RSS is void.
-- in --
<?xml version="1.0"?>
<rss version="2.0"><channel><link>http://example.com/</link><item xmlns="http://www.w3.org/1999/xhtml"><p>a<p>b<br></item></channel></rss>
-- tokens --
0 ProcInst xml "<?xml version=\"1.0\"?>" data=" version=\"1.0\""
0 Text "\n" text="\n"
1 StartTag rss "<rss version=\"2.0\">" ns="http://www.w3.org/1999/xhtml" version="2.0"
2 StartTag channel "<channel>" ns="http://www.w3.org/1999/xhtml"
3 StartTag link "<link>" ns="http://www.w3.org/1999/xhtml"
3 EndTag link [implied] ""
2 Text "http://example.com/" text="http://example.com/"
2 EndTag link [stray] "</link>"
3 StartTag item "<item xmlns=\"http://www.w3.org/1999/xhtml\">" ns="http://www.w3.org/1999/xhtml" xmlns="http://www.w3.org/1999/xhtml"
4 StartTag p "<p>" ns="http://www.w3.org/1999/xhtml"
4 Text "a" text="a"
4 EndTag p [implied] ""
4 StartTag p "<p>" ns="http://www.w3.org/1999/xhtml"
4 Text "b" text="b"
5 StartTag br "<br>" ns="http://www.w3.org/1999/xhtml"
5 EndTag br [implied] ""
4 EndTag p [implied] ""
3 EndTag item "</item>"
2 EndTag channel "</channel>"
1 EndTag rss "</rss>"
-- TextBeforeRoot universal --
After an XML declaration, text other than whitespace before the first tag
makes the document read as HTML.
-- in --
<?xml version="1.0"?>

&#32;<!--c-->x<html xmlns="http://www.w3.org/1999/xhtml"><p>a<p>b</html>
