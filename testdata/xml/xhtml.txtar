2 StartTag head "<head>" ns="http://www.w3.org/1999/xhtml"
3 StartTag meta "<meta charset=\"utf-8\">" ns="http://www.w3.org/1999/xhtml" charset="utf-8"
3 EndTag meta "</meta>"
3 StartTag link "<link rel=\"x\">" ns="http://www.w3.org/1999/xhtml" rel="x"
3 EndTag link [implied] ""
2 Text "\n" text="\n"
3 StartTag title "<title>" ns="http://www.w3.org/1999/xhtml"
3 Text "t" text="t"
