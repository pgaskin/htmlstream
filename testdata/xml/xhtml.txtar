2 StartTag br "<br>" ns="http://www.w3.org/1999/xhtml"
2 EndTag br [implied] ""
1 Text "c\u0085d" text="c\nd"
1 EndTag html "</html>"
-- VoidElementsCase universal --
Under XML rules, names are case-sensitive: BR isn't a void element.
-- in --
<?xml version="1.0"?>
<html xmlns="http://www.w3.org/1999/xhtml"><BR>x</BR><x:br xmlns:x="http://www.w3.org/1999/xhtml">y</html>
-- tokens --
0 ProcInst xml "<?xml version=\"1.0\"?>" data=" version=\"1.0\""
0 Text "\n" text="\n"
1 StartTag html "<html xmlns=\"http://www.w3.org/1999/xhtml\">" ns="http://www.w3.org/1999/xhtml" xmlns="http://www.w3.org/1999/xhtml"
2 StartTag BR "<BR>" ns="http://www.w3.org/1999/xhtml"
2 Text "x" text="x"
2 EndTag BR "</BR>"
2 StartTag x:br "<x:br xmlns:x=\"http://www.w3.org/1999/xhtml\">" ns="http://www.w3.org/1999/xhtml" xmlns:x="http://www.w3.org/1999/xhtml"
2 EndTag x:br [implied] ""
1 Text "y" text="y"
1 EndTag html "</html>"
-- VoidElementsSpace universal --
Whitespace between a void element under XML rules and its end tag is in the
element. Other content, including a character reference to a space, closes
it first.
-- in --
<?xml version="1.0"?>
<html xmlns="http://www.w3.org/1999/xhtml"><head><meta charset="utf-8">
  </meta><link rel="x">
<title>t</title></head><body><p>a<br> </br>b<br>  </br >c<br> d</br><br> <!--x--></br><img src="y">	
</img><br>&#32;</br><br> </b></p></body></html>
