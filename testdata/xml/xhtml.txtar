1 EndTag html "</html>"
-- PrologComments universal --
Comments before the first tag end like in HTML parsers, also at "--!>", and
<!--> is an empty comment. In the document, they follow XML rules.
-- in --
<?xml version="1.0"?>
<!--a--!><!--><html xmlns="http://www.w3.org/1999/xhtml"><!--b--!>c--></html>
-- tokens --
0 ProcInst xml "<?xml version=\"1.0\"?>" data=" version=\"1.0\""
0 Text "\n" text="\n"
0 Comment "<!--a--!>" text="a"
0 Comment "<!-->" text=""
1 StartTag html "<html xmlns=\"http://www.w3.org/1999/xhtml\">" ns="http://www.w3.org/1999/xhtml" xmlns="http://www.w3.org/1999/xhtml"
1 Comment "<!--b--!>c-->" text="b--!>c"
1 EndTag html "</html>"
