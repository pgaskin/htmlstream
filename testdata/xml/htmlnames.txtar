1 StartTag r "<r>"
2 StartTag svg "<svg>"
3 StartTag p "<p>"
3 Text "x" text="x"
3 EndTag p "</p>"
2 CDATA "<![CDATA[y]]>" text="y"
2 EndTag svg "</svg>"
2 StartTag math "<math>"
3 StartTag mi "<mi>"
3 StartTag div [self-closing] "<div/>"
3 EndTag mi "</mi>"
2 EndTag math "</math>"
1 EndTag r "</r>"
