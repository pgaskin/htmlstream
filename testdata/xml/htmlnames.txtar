Elements named like HTML elements with special parsing rules are ordinary
elements in XML mode.
-- RawText --
-- in --
<r><script>a<b/>&amp;</script><style>&lt;</style><xmp><x/></xmp><iframe><i/></iframe><noscript><n/></noscript><plaintext><p/></plaintext></r>
-- tokens --
1 StartTag r "<r>"
2 StartTag script "<script>"
2 Text "a" text="a"
2 StartTag b [self-closing] "<b/>"
2 Text "&amp;" text="&"
2 EndTag script "</script>"
2 StartTag style "<style>"
2 Text "&lt;" text="<"
2 EndTag style "</style>"
2 StartTag xmp "<xmp>"
2 StartTag x [self-closing] "<x/>"
2 EndTag xmp "</xmp>"
2 StartTag iframe "<iframe>"
2 StartTag i [self-closing] "<i/>"
2 EndTag iframe "</iframe>"
2 StartTag noscript "<noscript>"
2 StartTag n [self-closing] "<n/>"
2 EndTag noscript "</noscript>"
2 StartTag plaintext "<plaintext>"
2 StartTag p [self-closing] "<p/>"
2 EndTag plaintext "</plaintext>"
1 EndTag r "</r>"
-- RCDATA --
-- in --
<r><title><t/>&amp;</title><textarea>&amp;</textarea></r>
-- tokens --
1 StartTag r "<r>"
2 StartTag title "<title>"
2 StartTag t [self-closing] "<t/>"
2 Text "&amp;" text="&"
2 EndTag title "</title>"
2 StartTag textarea "<textarea>"
2 Text "&amp;" text="&"
2 EndTag textarea "</textarea>"
1 EndTag r "</r>"
-- Void --
